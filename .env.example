# OpenBuchhaltung — Umgebungsvariablen (Referenz).
#
# Kopieren nach .env (liegt neben den Compose-Dateien, gehört NICHT ins Repository).
# Docker Compose liest die Datei automatisch für die ${...}-Platzhalter und reicht
# sie zusätzlich in den app-Container. Auskommentierte Zeilen zeigen den Default.
# Vollständige Beschreibung: README → „Konfiguration (Umgebungsvariablen)“.

# ---------------------------------------------------------------------------
# Kern
# ---------------------------------------------------------------------------
# Laufzeitumgebung: production (Default) verlangt SECRET_KEY; development/dev/local
# erlaubt den unsicheren Entwicklungs-Secret. FLASK_ENV wird als Alias akzeptiert.
#APP_ENV=production
#FLASK_ENV=
# Session-Secret (Pflicht außerhalb von development): openssl rand -hex 32
#SECRET_KEY=
# Datenbank-URL (SQLAlchemy). Ohne Angabe: SQLite unter instance/openbuchhaltung.db.
# Der Produktions-Stack setzt sie selbst aus POSTGRES_PASSWORD zusammen.
#DATABASE_URL=postgresql+psycopg://openbuchhaltung:<passwort>@db:5432/openbuchhaltung
# Secure-Flag für das Session-Cookie (1 hinter HTTPS).
#SESSION_COOKIE_SECURE=0
# Port des Entwicklungsservers (python run.py).
#PORT=8000
# Schema-Migrationen beim App-Start (1 = automatisch bis Alembic-Head, 0 = nie;
# dann muss `alembic upgrade head` als eigener Schritt laufen, sonst startet die
# App nicht). Der Produktions-Stack setzt 0.
#DB_AUTO_MIGRATE=1
# Commit-Kennung im Health-Endpoint und Prüferexport-Manifest (Docker: Build-Arg).
#GIT_COMMIT=
#APP_COMMIT_SHA=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
#LOG_LEVEL=INFO
# text (lesbar) | json (eine JSON-Zeile je Eintrag)
#LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Authentifizierung und Härtung
# ---------------------------------------------------------------------------
# Globaler API-Token (Bearer) für REST-API und MCP-Server → API. Leer = nur
# Benutzer-Tokens (flask set-api-token).
#API_AUTH_TOKEN=
# API-Auth erzwingen (1). 0 nur für lokale Entwicklung ohne Token.
#API_REQUIRE_AUTH=1
# CSRF-Schutz für UI-Formulare.
#CSRF_PROTECT=1
# Login-Rate-Limit: Versuche je Fenster (Sekunden).
#LOGIN_RATE_LIMIT=1
#LOGIN_RATE_LIMIT_ATTEMPTS=5
#LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# ---------------------------------------------------------------------------
# Beleg-Upload
# ---------------------------------------------------------------------------
# Maximal-/Mindestgröße hochgeladener Belege in Bytes (10 MiB / 1 KiB).
#DOCUMENT_MAX_UPLOAD_BYTES=10485760
#DOCUMENT_MIN_UPLOAD_BYTES=1024

# ---------------------------------------------------------------------------
# LLM-Endpunkte (OpenAI-/responses-kompatibel). Fallback-Kette:
# CHAT/RECEIPT_* → DOCUMENT_LLM_*; ohne Endpoint bleiben die Funktionen inaktiv.
# ---------------------------------------------------------------------------
#DOCUMENT_LLM_ENDPOINT_URL=
#DOCUMENT_LLM_MODEL=gpt-4.1-mini
# Beleg-OCR (Text-/Feldextraktion aus PDF/Bild)
#RECEIPT_OCR_ENDPOINT_URL=
#RECEIPT_OCR_MODEL=gpt-4.1-mini
# Feld-Extraktion / Kontrolle des Buchungsvorschlags
#RECEIPT_LLM_ENDPOINT_URL=
#RECEIPT_LLM_MODEL=gpt-4.1-mini
# Belegabgleich (Beleg ↔ vorhandene Buchungen)
#RECEIPT_MATCH_LLM_ENDPOINT_URL=
#RECEIPT_MATCH_LLM_MODEL=gpt-4.1-mini
# KI-Chat mit Tool-Zugriff
#CHAT_LLM_ENDPOINT_URL=
#CHAT_LLM_MODEL=gpt-4.1-mini
#CHAT_LLM_API_KEY=
#CHAT_LLM_MAX_TOOL_CALLS=15
#CHAT_LLM_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Bank (FinTS), DATEV, Rechnungssteller (E-Rechnung)
# ---------------------------------------------------------------------------
# FinTS-Produktkennung der Deutschen Kreditwirtschaft (Pflicht für Direktabruf).
#FINTS_PRODUCT_ID=
# DATEV-Export: Beraternummer und Mandantennummer.
#DATEV_CONSULTANT_NUMBER=1000
#DATEV_CLIENT_NUMBER=
# Anschrift/USt-IdNr. des Rechnungsstellers für E-Rechnungs-Export.
#SELLER_STREET=
#SELLER_POSTAL_CODE=
#SELLER_CITY=
#SELLER_COUNTRY_CODE=DE
#SELLER_VAT_ID=

# ---------------------------------------------------------------------------
# ELSTER-Bridge (lokaler ERiC-Runner) — optional
# ---------------------------------------------------------------------------
# test | production
#ELSTER_ENVIRONMENT=test
#ELSTER_ERIC_LIBRARY_PATH=
#ELSTER_CERTIFICATE_PATH=
#ELSTER_CERTIFICATE_ALIAS=
#ELSTER_ERIC_COMMAND=
#ELSTER_ERIC_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Lohn: externe Runner (Lohnsteuer-PAP, ELStAM, DEÜV) — optional
# ---------------------------------------------------------------------------
#PAYROLL_PAP_COMMAND=
#PAYROLL_PAP_TIMEOUT_SECONDS=30
#PAYROLL_PARAMETER_VERSION=manual
#PAYROLL_ELSTAM_COMMAND=
#PAYROLL_DEUEV_COMMAND=

# ---------------------------------------------------------------------------
# MCP-Server (python -m app.services.mcp_server / mcp_http)
# ---------------------------------------------------------------------------
# REST-API, die der MCP-Server aufruft, und sein Backend-Token (= API_AUTH_TOKEN).
# Code-Default ist http://localhost:5000/api/v1; die App läuft auf 8000 → setzen.
#OPENBUCHHALTUNG_API_URL=http://localhost:8000/api/v1
#OPENBUCHHALTUNG_API_TOKEN=
# Streamable-HTTP-Transport: Bind-Adresse, Port, Pfad, erlaubte Browser-Origins
# (kommagetrennt, * = alle) und Eingangstoken (Pflicht bei Nicht-Loopback-Bindung).
#MCP_HTTP_HOST=127.0.0.1
#MCP_HTTP_PORT=8080
#MCP_HTTP_PATH=/mcp
#MCP_HTTP_ALLOWED_ORIGINS=
#MCP_HTTP_AUTH_TOKEN=
# Externer MCP-Server für den Proxy-Endpunkt POST /api/v1/mcp/call (optional).
#MCP_SERVER_URL=

# ---------------------------------------------------------------------------
# Docker Compose (nur von den Compose-Dateien/Skripten gelesen)
# ---------------------------------------------------------------------------
# Passwort der mitgelieferten PostgreSQL (Pflicht im Produktions-Stack).
#POSTGRES_PASSWORD=
# Benutzer/Datenbankname für backup.sh (Default openbuchhaltung).
#POSTGRES_USER=openbuchhaltung
#POSTGRES_DB=openbuchhaltung
# Host-Port der Web-App (Produktions-Stack, an 127.0.0.1 gebunden).
#APP_PORT=8000
# Bind-Adresse der UI im Entwicklungs-Stack (0.0.0.0 = im Netz erreichbar!).
#APP_BIND_HOST=127.0.0.1
# gunicorn-Worker im Produktions-Stack.
#GUNICORN_WORKERS=2
# Dauerhaft aktive Compose-Profile, z. B. mcp oder proxy.
#COMPOSE_PROFILES=
# Öffentliche Domain für den Caddy-HTTPS-Proxy vor dem MCP-Server.
#MCP_DOMAIN=
# redeploy.sh/backup.sh: Compose-Datei, Backup-Ziel und Aufbewahrung.
#COMPOSE_FILE=docker-compose.production.yml
#BACKUP_DIR=./backups
#BACKUP_KEEP=14
